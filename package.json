{
  "name": "@danyalwe/tools",
  "type": "module",
  "version": "0.1.5",
  "packageManager": "bun@1.4.2",
  "description": "A collection of data structures, algorithms, and utilities for TypeScript",
  "author": {
    "name": "zAlweNy26",
    "email": "alwe.dev@gmail.com",
    "url": "https://www.github.com/zAlweNy26"
  },
  "license": "MIT",
  "homepage": "https://github.com/zAlweNy26/tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zAlweNy26/tools.git"
  },
  "bugs": {
    "url": "https://github.com/zAlweNy26/tools/issues"
  },
  "keywords": [
    "algorithms",
    "data structures",
    "structures",
    "dimensionality reduction",
    "module",
    "distances",
    "sortings",
    "helpers",
    "utils",
    "tools"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "test": "bun test",
    "generate": "typedoc && bun run docs/.vitepress/coverage-badge.ts",
    "start": "bun --watch index.ts",
    "docs:dev": "bun run generate && vitepress dev docs",
    "docs:build": "bun run generate && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@arethetypeswrong/core": "^0.18.5",
    "@types/bun": "^1.4.2",
    "eslint": "^10.12.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  }
}
